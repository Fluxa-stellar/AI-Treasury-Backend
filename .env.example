# Environment Configuration
NODE_ENV=development
PORT=4000

# Neon PostgreSQL Database Connections
DATABASE_URL="postgresql://username:password@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-direct.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-replace-in-production"
JWT_EXPIRES_IN=7d

# Frontend Application Origin
FRONTEND_URL=http://localhost:3000

# BNB Smart Chain Configuration (Default: BSC Testnet)
BNB_CHAIN_ID=97
BNB_NETWORK=testnet
BNB_RPC_URL=https://bsc-testnet-rpc.publicnode.com
BNB_PLATFORM_PRIVATE_KEY=your_optional_agent_operator_private_key

# Treasury Smart Contract
TREASURY_CONTRACT_ADDRESS=0xFc6E3Ec48AB20fA72D88cb7c985d85E23971105A

# AI LLM Provider (Groq / Qwen / Llama)
AI_API_KEY=gsk_your_groq_api_key_here
AI_MODEL=qwen/qwen3.8-27b

# Optional Redis Cache / Queue
REDIS_URL=redis://localhost:6379
